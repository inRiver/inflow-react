{
  "name": "inriver-inflow",
  "version": "0.1.0",
  "description": "Shared Inflow React/MUI design-system: canonical theme, design tokens, and themed wrapper components for Inriver product UIs.",
  "keywords": [
    "inriver",
    "inflow",
    "design-system",
    "mui",
    "react",
    "theme"
  ],
  "homepage": "https://github.com/richard-orilla_inriver/inflow-react#readme",
  "bugs": {
    "url": "https://github.com/richard-orilla_inriver/inflow-react/issues"
  },
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richard-orilla_inriver/inflow-react.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/components",
    "dist/theme"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "prepublishOnly": "node scripts/guard-publish.cjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/material": ">=6.3.0 <6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@playwright/test": "^1.61.0",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@types/node": "^24.12.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "clipboard-copy": "^4.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "react-simple-code-editor": "^0.14.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
