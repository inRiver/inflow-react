{
  "name": "@inriver/inflow-react",
  "version": "3.7.2",
  "description": "Shared Inflow React/MUI design-system: canonical theme, design tokens, and themed wrapper components for Inriver product UIs.",
  "keywords": [
    "inriver",
    "inflow",
    "design-system",
    "mui",
    "react",
    "theme"
  ],
  "homepage": "https://github.com/inRiver/inflow-react#readme",
  "bugs": {
    "url": "https://github.com/inRiver/inflow-react/issues"
  },
  "private": false,
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inRiver/inflow-react.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/tokens.js",
    "dist/tokens.js.map",
    "dist/tokens.cjs",
    "dist/tokens.cjs.map",
    "dist/ag-grid",
    "dist/components",
    "dist/providers",
    "dist/theme"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ag-grid": {
      "types": "./dist/ag-grid/index.d.ts",
      "import": "./dist/ag-grid/index.js",
      "require": "./dist/ag-grid/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "node scripts/guard-publish.cjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/material": ">=9.0.0 <10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "clipboard-copy": "^4.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-simple-code-editor": "^0.14.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@mui/x-date-pickers": "^9.14.0",
    "dayjs": "^1.11.23"
  },
  "overrides": {
    "react-router": ">=7.18.2",
    "postcss": ">=8.5.23",
    "undici": ">=7.29.0"
  }
}
