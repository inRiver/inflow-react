{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src/cli",
    "outDir": "dist/cli",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/cli/**/*.ts"
  ],
  "exclude": [
    "src/cli/**/*.test.ts"
  ]
}
